# .env.example — copy to .env for local development (never commit .env)
# NAMES ONLY, no values. In CI these come from GitHub Actions secrets
# (repo Settings → Secrets and variables → Actions).

# SMTP sender for pipeline failure-alert emails (secret MAIL_USERNAME)
MAIL_USERNAME=
# SMTP app password/key for failure-alert emails (secret MAIL_PASSWORD)
MAIL_PASSWORD=
# Recipient address for failure alerts (secret ALERT_EMAIL_TO)
ALERT_EMAIL_TO=

# Token for pushing data backups to the PRIVATE backup repo (local runs only;
# CI maps secrets.BACKUP_REPO_TOKEN to this env var). Never commit the value.
GH_BACKUP_TOKEN=

# Optional local overrides
SESSION_OVERRIDE=
DRY_RUN=true
