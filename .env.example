# Environment variables — NAMES ONLY, no values.
# Copy to .env (git-ignored) for local runs. In CI, set these as
# GitHub Actions secrets (repo Settings → Secrets and variables → Actions).
# Currently used by the phase-1 pipeline branch (PR #37); main uses none.

# SMTP sender for pipeline failure-alert emails
MAIL_USERNAME=
# SMTP app password for failure-alert emails
MAIL_PASSWORD=
# Recipient address for failure alerts
ALERT_EMAIL_TO=

# Token for pushing data backups to the PRIVATE backup repo (local runs only;
# CI uses secrets.GITHUB_TOKEN). Never commit the real value.
GH_BACKUP_TOKEN=
