# .env.example — copy to .env for local development (never commit .env)
# Names only; values live in GitHub repo secrets / local environment.

# SMTP for pipeline alert emails (GitHub secrets: MAIL_USERNAME, MAIL_PASSWORD, ALERT_EMAIL_TO)
MAIL_USERNAME=
MAIL_PASSWORD=
ALERT_EMAIL_TO=

# Optional local overrides
SESSION_OVERRIDE=
DRY_RUN=true
