diff --git a/css/broker-pages.css b/css/broker-pages.css
new file mode 100644
index 00000000..19591bfe
--- /dev/null
+++ b/css/broker-pages.css
@@ -0,0 +1,35 @@
+/* P16: shared broker page styles — editorial theme */
+.bk-wrap{ max-width: 1160px; margin: 0 auto; padding: 24px 16px; }
+.bk-eyebrow{ font-size: 10px; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; color: var(--nd-lime, #B8E62E); margin: 0 0 8px; }
+.bk-title{ font-family: var(--serif, Spectral, serif); font-size: 28px; margin: 0 0 6px; color: var(--nd-text, #fff); }
+.bk-sub{ color: var(--ink-soft, #4A463C); max-width: 680px; font-size: .95rem; line-height: 1.6; margin: 0 0 18px; }
+.bk-meta{ font-size: .82rem; color: var(--muted, #6F6A5E); margin-bottom: 16px; }
+.bk-periods{ display: flex; gap: 6px; flex-wrap: wrap; margin: 0 0 16px; align-items: center; }
+.bk-periods button{ border: 1px solid var(--hairline, #E7DFCE); background: var(--card, #fff); border-radius: 999px; padding: 6px 14px; font-size: .85rem; cursor: pointer; color: var(--ink-soft, #4A463C); }
+.bk-periods button.active{ background: var(--green-900, #0B3D2E); color: #fff; border-color: var(--green-900, #0B3D2E); }
+.bk-ctl{ display: flex; gap: 10px; flex-wrap: wrap; margin: 0 0 16px; align-items: center; }
+.bk-ctl select, .bk-ctl input{ border: 1px solid var(--hairline, #E7DFCE); border-radius: 8px; padding: 8px 12px; font-size: .9rem; background: var(--card, #fff); max-width: 100%; }
+.bk-scroll{ overflow-x: auto; margin: 12px 0; border: 1px solid var(--hairline, #E7DFCE); border-radius: 12px; }
+.bk-table{ width: 100%; border-collapse: collapse; font-size: .85rem; background: var(--card, #fff); min-width: 640px; }
+.bk-table th, .bk-table td{ padding: 9px 12px; text-align: right; border-bottom: 1px solid var(--hairline-soft, #EFE9D8); white-space: nowrap; }
+.bk-table th:first-child, .bk-table td:first-child{ text-align: left; }
+.bk-table th{ background: var(--paper-deep, #F5F1E6); font-weight: 600; color: var(--ink-soft, #4A463C); position: sticky; top: 0; user-select: none; }
+.bk-table th[data-sort]:hover{ color: var(--green-900, #0B3D2E); }
+.bk-table th.sorted-asc, .bk-table th.sorted-desc{ color: var(--green-900, #0B3D2E); }
+.bk-table .sort-ind{ font-size: .7em; }
+.bk-table tr:last-child td{ border-bottom: none; }
+.bk-table tbody tr:hover{ background: var(--paper-deep, #F5F1E6); }
+.pos{ color: var(--up, #1A7F37); font-weight: 600; }
+.neg{ color: var(--down, #CF222E); font-weight: 600; }
+.bk-tiles{ display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin: 12px 0 18px; }
+@media(min-width: 760px){ .bk-tiles{ grid-template-columns: repeat(4, 1fr); } }
+.bk-tile{ background: var(--card, #fff); border: 1px solid var(--hairline, #E7DFCE); border-radius: 12px; padding: 14px 16px; }
+.bk-tile .k{ font-size: 11px; color: var(--muted, #6F6A5E); text-transform: uppercase; letter-spacing: .09em; font-weight: 600; }
+.bk-tile .v{ font-size: 1.3rem; font-weight: 700; margin-top: 4px; }
+.bk-tile .s{ font-size: 12px; color: var(--muted, #6F6A5E); margin-top: 2px; }
+.bk-nav{ display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 20px; }
+.bk-nav a{ padding: 8px 16px; border-radius: 999px; border: 1px solid var(--hairline, #E7DFCE); text-decoration: none; font-size: .85rem; font-weight: 600; color: var(--ink-soft, #4A463C); background: var(--card, #fff); }
+.bk-nav a.active{ background: var(--green-900, #0B3D2E); color: #fff; border-color: var(--green-900, #0B3D2E); }
+.bk-note{ font-size: .82rem; color: var(--muted, #6F6A5E); margin: 24px 0 0; line-height: 1.7; }
+.bk-loading{ color: var(--muted, #6F6A5E); padding: 24px 0; }
+.bk-empty{ background: var(--gold-soft, #FFF8E1); border: 1px solid var(--hairline, #E7DFCE); border-radius: 12px; padding: 14px 18px; font-size: .9rem; color: var(--ink-soft, #4A463C); margin: 12px 0; }
diff --git a/css/nd-actions.css b/css/nd-actions.css
new file mode 100644
index 00000000..7ea605e0
--- /dev/null
+++ b/css/nd-actions.css
@@ -0,0 +1,128 @@
+/**
+ * css/nd-actions.css — Corporate Actions archive (Concept 03 editorial, P17).
+ * Magazine-style notice cards on --nd-* theme tokens.
+ */
+
+.na-wrap { max-width: var(--nd-page-max, 1360px); margin: 0 auto; padding: 0 var(--nd-gutter, 24px); }
+
+/* ---------- Masthead ---------- */
+.na-masthead { margin: 8px 0 20px; }
+.na-kicker {
+  font: 600 0.72rem var(--nd-font-mono, "IBM Plex Mono", monospace);
+  letter-spacing: 0.14em; text-transform: uppercase;
+  color: var(--nd-lime); margin: 0 0 8px;
+}
+.na-masthead h1 {
+  font-family: var(--nd-font-display, "Spectral", Georgia, serif);
+  font-weight: 600; font-size: clamp(1.7rem, 4vw, 2.5rem);
+  letter-spacing: -0.015em; color: var(--nd-text); margin: 0;
+}
+.na-lede { margin: 10px 0 0; max-width: 76ch; color: var(--nd-muted); line-height: 1.65; font-size: 0.95rem; }
+.na-meta-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; align-items: center; }
+.na-badge {
+  font: 600 0.7rem var(--nd-font-mono, "IBM Plex Mono", monospace);
+  letter-spacing: 0.06em; text-transform: uppercase;
+  padding: 6px 12px; border-radius: 6px;
+  border: 1px solid var(--nd-border); color: var(--nd-muted);
+  background: var(--nd-panel);
+}
+.na-badge.lime { color: var(--nd-lime); border-color: var(--nd-lime); }
+
+/* ---------- Filters ---------- */
+.na-filters {
+  display: flex; flex-wrap: wrap; gap: 10px; align-items: center;
+  margin: 18px 0 6px;
+}
+.na-select {
+  background: var(--nd-panel); border: 1px solid var(--nd-border);
+  color: var(--nd-text); border-radius: 8px; padding: 10px 12px;
+  font: 500 0.85rem var(--nd-font-sans, Inter, sans-serif);
+}
+.na-search {
+  flex: 1 1 200px; max-width: 300px;
+  background: var(--nd-panel); border: 1px solid var(--nd-border);
+  color: var(--nd-text); border-radius: 8px; padding: 10px 14px;
+  font: 500 0.9rem var(--nd-font-sans, Inter, sans-serif);
+}
+.na-search::placeholder { color: var(--nd-dim); }
+.na-search:focus, .na-select:focus { outline: none; border-color: var(--nd-lime); }
+.na-count { font-size: 0.82rem; color: var(--nd-dim); white-space: nowrap; }
+.na-pills { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0 4px; }
+.na-pill {
+  background: var(--nd-panel); border: 1px solid var(--nd-border);
+  color: var(--nd-muted); border-radius: 999px; padding: 8px 16px;
+  font: 600 0.8rem var(--nd-font-sans, Inter, sans-serif);
+  cursor: pointer; transition: border-color 0.15s, color 0.15s;
+}
+.na-pill:hover { border-color: var(--nd-lime); color: var(--nd-text); }
+.na-pill[aria-selected="true"] { background: var(--nd-lime); border-color: var(--nd-lime); color: var(--nd-on-lime); }
+
+/* ---------- Year head ---------- */
+.na-year {
+  font: 600 0.72rem var(--nd-font-mono, "IBM Plex Mono", monospace);
+  letter-spacing: 0.14em; color: var(--nd-dim); text-transform: uppercase;
+  margin: 28px 0 12px; padding-top: 20px; border-top: 1px solid var(--nd-border);
+}
+
+/* ---------- Notice cards ---------- */
+.na-feed { display: grid; grid-template-columns: 1fr; gap: 14px; }
+@media (min-width: 860px) { .na-feed { grid-template-columns: repeat(2, 1fr); } }
+.na-card {
+  background: var(--nd-panel); border: 1px solid var(--nd-border);
+  border-radius: var(--nd-r-card, 18px); padding: 20px;
+  display: flex; flex-direction: column; gap: 10px;
+  transition: border-color 0.15s, transform 0.15s;
+}
+.na-card:hover { border-color: var(--nd-lime); transform: translateY(-2px); }
+.na-top { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
+.na-kind {
+  font: 700 0.66rem var(--nd-font-mono, "IBM Plex Mono", monospace);
+  letter-spacing: 0.1em; text-transform: uppercase;
+  padding: 4px 12px; border-radius: 999px;
+  background: var(--nd-lime-faint, rgba(184,230,46,0.06));
+  color: var(--nd-lime); border: 1px solid var(--nd-lime);
+}
+.na-kind.k-dividend { color: var(--nd-up); border-color: var(--nd-up); background: var(--nd-up-soft); }
+.na-kind.k-bonus-share { color: var(--nd-info, #3080FF); border-color: var(--nd-info, #3080FF); background: rgba(48,128,255,0.1); }
+.na-kind.k-right-share { color: var(--nd-amber, #F5B301); border-color: var(--nd-amber, #F5B301); background: rgba(245,179,1,0.1); }
+.na-kind.k-promoter-share { color: var(--nd-down); border-color: var(--nd-down); background: var(--nd-down-soft); }
+.na-kind.k-auction { color: var(--nd-muted); border-color: var(--nd-border-strong); background: var(--nd-panel-2); }
+.na-sym {
+  font: 700 0.78rem var(--nd-font-mono, "IBM Plex Mono", monospace);
+  color: var(--nd-text); text-decoration: none; letter-spacing: 0.04em;
+}
+.na-sym:hover { color: var(--nd-lime); }
+.na-head {
+  font-family: var(--nd-font-display, "Spectral", Georgia, serif);
+  font-weight: 600; font-size: 1.08rem; line-height: 1.4;
+  color: var(--nd-text); margin: 0;
+}
+.na-card:hover .na-head { color: var(--nd-lime); }
+.na-facts {
+  display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px 14px;
+  margin: 4px 0 0; padding: 12px 14px;
+  background: var(--nd-inset); border: 1px solid var(--nd-border); border-radius: 10px;
+}
+.na-fact dt { font: 600 0.64rem var(--nd-font-mono, monospace); letter-spacing: 0.08em; text-transform: uppercase; color: var(--nd-dim); margin: 0 0 2px; }
+.na-fact dd { margin: 0; font-size: 0.85rem; color: var(--nd-text); font-variant-numeric: tabular-nums; }
+.na-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 0.78rem; color: var(--nd-dim); margin: auto 0 0; padding-top: 8px; border-top: 1px solid var(--nd-border); }
+.na-meta a { color: var(--nd-lime); font-weight: 600; text-decoration: none; }
+.na-meta a:hover { text-decoration: underline; }
+.na-dot { opacity: 0.5; }
+
+/* ---------- Pager ---------- */
+.na-pager { display: flex; align-items: center; gap: 14px; margin: 26px 0 8px; flex-wrap: wrap; }
+.na-page-btn {
+  background: var(--nd-panel); border: 1px solid var(--nd-border);
+  color: var(--nd-text); border-radius: 8px; padding: 9px 16px;
+  font: 600 0.85rem var(--nd-font-sans, Inter, sans-serif); cursor: pointer;
+}
+.na-page-btn:hover:not(:disabled) { border-color: var(--nd-lime); }
+.na-page-btn:disabled { opacity: 0.4; cursor: default; }
+.na-page-info { font-size: 0.82rem; color: var(--nd-dim); }
+.na-disc { font-size: 0.82rem; color: var(--nd-dim); line-height: 1.65; margin: 22px 0 0; max-width: 88ch; }
+.na-empty {
+  padding: 40px 20px; text-align: center; color: var(--nd-dim); font-size: 0.92rem;
+  border: 1px dashed var(--nd-border-strong); border-radius: var(--nd-r-card, 18px);
+  background: var(--nd-panel); grid-column: 1 / -1;
+}
diff --git a/css/nd-circuit.css b/css/nd-circuit.css
new file mode 100644
index 00000000..e6bd6c75
--- /dev/null
+++ b/css/nd-circuit.css
@@ -0,0 +1,158 @@
+/* ============================================================
+   css/nd-circuit.css — Circuit Watch page (Concept 03 editorial).
+   Dark terminal default (#0A0C10 / lime #B8E62E), theme-aware.
+   ============================================================ */
+
+.cw-masthead { margin: 8px 0 24px; }
+.nd-kicker {
+  font: 600 0.75rem var(--nd-font-mono, 'IBM Plex Mono', monospace);
+  letter-spacing: 0.14em; text-transform: uppercase;
+  color: var(--nd-lime, #B8E62E); margin: 0 0 8px;
+}
+.cw-title {
+  font-family: var(--nd-font-display, 'Spectral', serif);
+  font-weight: 600; font-size: clamp(1.8rem, 4.5vw, 2.6rem);
+  letter-spacing: -0.015em; color: var(--nd-text, #fff); margin: 0;
+}
+.cw-lede {
+  max-width: 76ch; color: var(--nd-muted, #9AA3B2);
+  font-size: 1rem; line-height: 1.7; margin: 12px 0 0;
+}
+.cw-lede strong { color: var(--nd-text, #fff); }
+.cw-meta {
+  margin: 12px 0 0; font-size: 0.85rem; color: var(--nd-dim, #6B7280);
+  font-family: var(--nd-font-mono, 'IBM Plex Mono', monospace);
+}
+
+/* Legend */
+.cw-legend {
+  display: flex; flex-wrap: wrap; gap: 8px 20px;
+  padding: 14px 18px; margin-bottom: 24px;
+  background: var(--nd-panel, #12141A);
+  border: 1px solid var(--nd-border, #1E2430);
+  border-radius: 12px; font-size: 0.85rem; color: var(--nd-muted, #9AA3B2);
+}
+.cw-band-hit-up { color: #4ADE80; font-weight: 600; }
+.cw-band-near-up { color: #86EFAC; }
+.cw-band-hit-dn { color: #F87171; font-weight: 600; }
+.cw-band-near-dn { color: #FCA5A5; }
+[data-theme="light"] .cw-band-hit-up { color: #15803d; }
+[data-theme="light"] .cw-band-near-up { color: #16a34a; }
+[data-theme="light"] .cw-band-hit-dn { color: #b91c1c; }
+[data-theme="light"] .cw-band-near-dn { color: #dc2626; }
+
+/* Alert banner */
+.cw-alert {
+  padding: 14px 18px; border-radius: 12px; margin-bottom: 24px;
+  font-size: 0.95rem; line-height: 1.6;
+  background: rgba(184, 230, 46, 0.08);
+  border: 1px solid rgba(184, 230, 46, 0.35);
+  color: var(--nd-text, #fff);
+}
+.cw-alert.cw-alert-hit {
+  background: rgba(248, 113, 113, 0.08);
+  border-color: rgba(248, 113, 113, 0.4);
+}
+
+/* Sections */
+.cw-sec { margin-bottom: 32px; }
+.cw-sec-head {
+  display: flex; justify-content: space-between; align-items: baseline;
+  margin-bottom: 12px;
+}
+.cw-sec-head h2 {
+  font-family: var(--nd-font-display, 'Spectral', serif);
+  font-weight: 600; font-size: 1.35rem; color: var(--nd-text, #fff);
+  margin: 0; display: flex; align-items: center; gap: 10px;
+}
+.cw-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
+.cw-dot.up { background: #4ADE80; box-shadow: 0 0 8px rgba(74, 222, 128, 0.7); }
+.cw-dot.dn { background: #F87171; box-shadow: 0 0 8px rgba(248, 113, 113, 0.7); }
+.cw-count {
+  font-family: var(--nd-font-mono, 'IBM Plex Mono', monospace);
+  font-size: 0.8rem; color: var(--nd-dim, #6B7280);
+}
+
+/* Table */
+.table-scroll { overflow-x: auto; border-radius: 12px; }
+.cw-table {
+  width: 100%; border-collapse: collapse; font-size: 0.92rem;
+  background: var(--nd-panel, #12141A);
+  border: 1px solid var(--nd-border, #1E2430);
+  border-radius: 12px; overflow: hidden;
+}
+.cw-table th {
+  text-align: left; padding: 12px 16px;
+  font: 600 0.72rem var(--nd-font-mono, 'IBM Plex Mono', monospace);
+  letter-spacing: 0.08em; text-transform: uppercase;
+  color: var(--nd-dim, #6B7280);
+  border-bottom: 1px solid var(--nd-border, #1E2430);
+  white-space: nowrap;
+}
+.cw-table th.num, .cw-table td.num { text-align: right; font-variant-numeric: tabular-nums; }
+.cw-table td {
+  padding: 12px 16px; border-bottom: 1px solid var(--nd-border, #1E2430);
+  color: var(--nd-text, #fff); font-variant-numeric: tabular-nums;
+}
+.cw-table tr:last-child td { border-bottom: 0; }
+.cw-table tbody tr:hover { background: rgba(184, 230, 46, 0.04); }
+.cw-sym { font-weight: 700; }
+.cw-sym a { color: var(--nd-text, #fff); text-decoration: none; }
+.cw-sym a:hover { color: var(--nd-lime, #B8E62E); }
+.cw-name { display: block; font-size: 0.78rem; font-weight: 400; color: var(--nd-dim, #6B7280); max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.cw-up { color: #4ADE80; font-weight: 600; }
+.cw-dn { color: #F87171; font-weight: 600; }
+[data-theme="light"] .cw-up { color: #15803d; }
+[data-theme="light"] .cw-dn { color: #b91c1c; }
+.cw-loading, .cw-empty {
+  text-align: center; padding: 28px 16px !important;
+  color: var(--nd-dim, #6B7280); font-style: italic;
+}
+.cw-status {
+  display: inline-block; padding: 3px 10px; border-radius: 999px;
+  font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
+  white-space: nowrap;
+}
+.cw-status.hit-up { background: rgba(74, 222, 128, 0.15); color: #4ADE80; }
+.cw-status.near-up { background: rgba(74, 222, 128, 0.07); color: #86EFAC; }
+.cw-status.hit-dn { background: rgba(248, 113, 113, 0.15); color: #F87171; }
+.cw-status.near-dn { background: rgba(248, 113, 113, 0.07); color: #FCA5A5; }
+[data-theme="light"] .cw-status.hit-up { color: #15803d; }
+[data-theme="light"] .cw-status.near-up { color: #16a34a; }
+[data-theme="light"] .cw-status.hit-dn { color: #b91c1c; }
+[data-theme="light"] .cw-status.near-dn { color: #dc2626; }
+
+/* Calm state */
+.cw-calm {
+  padding: 28px; border-radius: 14px; margin-bottom: 32px;
+  background: var(--nd-panel, #12141A);
+  border: 1px solid var(--nd-border, #1E2430);
+  text-align: center;
+}
+.cw-calm h2 {
+  font-family: var(--nd-font-display, 'Spectral', serif);
+  color: var(--nd-lime, #B8E62E); margin: 0 0 8px; font-size: 1.4rem;
+}
+.cw-calm p { color: var(--nd-muted, #9AA3B2); max-width: 60ch; margin: 0 auto; line-height: 1.7; }
+
+/* Explainer */
+.cw-note {
+  padding: 24px; border-radius: 14px; margin-bottom: 24px;
+  background: var(--nd-panel, #12141A);
+  border: 1px solid var(--nd-border, #1E2430);
+}
+.cw-note h2 {
+  font-family: var(--nd-font-display, 'Spectral', serif);
+  font-size: 1.2rem; color: var(--nd-text, #fff); margin: 0 0 12px;
+}
+.cw-note ul { margin: 0; padding-left: 20px; color: var(--nd-muted, #9AA3B2); line-height: 1.8; font-size: 0.92rem; }
+.cw-note strong { color: var(--nd-text, #fff); }
+.cw-fineprint {
+  font-size: 0.82rem; color: var(--nd-dim, #6B7280); line-height: 1.7;
+  border-top: 1px solid var(--nd-border, #1E2430); padding-top: 18px;
+}
+
+@media (max-width: 640px) {
+  .cw-table th, .cw-table td { padding: 10px 12px; font-size: 0.85rem; }
+  .cw-name { max-width: 140px; }
+}
diff --git a/css/nd-daily.css b/css/nd-daily.css
new file mode 100644
index 00000000..90b1b68e
--- /dev/null
+++ b/css/nd-daily.css
@@ -0,0 +1,126 @@
+/**
+ * css/nd-daily.css — NEPSE Daily Summary page (Concept 03 editorial).
+ * Sortable full-market table, 50 rows/page pagination, symbol search.
+ * Uses --nd-* theme variables so light/dark both work.
+ */
+
+.ds-wrap { max-width: var(--nd-page-max, 1360px); margin: 0 auto; padding: 0 var(--nd-gutter, 24px); }
+
+/* ---------- Masthead ---------- */
+.ds-masthead { margin: 8px 0 20px; }
+.ds-kicker {
+  font: 600 0.72rem var(--nd-font-mono, "IBM Plex Mono", monospace);
+  letter-spacing: 0.14em; text-transform: uppercase;
+  color: var(--nd-lime); margin: 0 0 8px;
+}
+.ds-masthead h1 {
+  font-family: var(--nd-font-display, "Fraunces", serif);
+  font-weight: 600; font-size: clamp(1.6rem, 4vw, 2.4rem);
+  letter-spacing: -0.015em; color: var(--nd-text); margin: 0;
+}
+.ds-lede { margin: 10px 0 0; max-width: 76ch; color: var(--nd-muted); line-height: 1.65; font-size: 0.95rem; }
+.ds-meta-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; align-items: center; }
+.ds-badge {
+  font: 600 0.7rem var(--nd-font-mono, "IBM Plex Mono", monospace);
+  letter-spacing: 0.06em; text-transform: uppercase;
+  padding: 6px 12px; border-radius: 6px;
+  border: 1px solid var(--nd-border); color: var(--nd-muted);
+  background: var(--nd-panel);
+}
+.ds-badge.lime { color: var(--nd-lime); border-color: var(--nd-lime); }
+.ds-badge .dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--nd-up); margin-right: 6px; }
+
+/* ---------- Controls ---------- */
+.ds-controls {
+  display: flex; flex-wrap: wrap; gap: 10px; align-items: center;
+  margin: 18px 0 6px;
+}
+.ds-search {
+  flex: 1 1 220px; max-width: 340px;
+  background: var(--nd-panel); border: 1px solid var(--nd-border);
+  color: var(--nd-text); border-radius: 8px; padding: 10px 14px;
+  font: 500 0.9rem var(--nd-font-sans, Inter, system-ui, sans-serif);
+}
+.ds-search::placeholder { color: var(--nd-dim); }
+.ds-search:focus { outline: none; border-color: var(--nd-lime); }
+.ds-select {
+  background: var(--nd-panel); border: 1px solid var(--nd-border);
+  color: var(--nd-text); border-radius: 8px; padding: 10px 12px;
+  font: 500 0.85rem var(--nd-font-sans, Inter, system-ui, sans-serif);
+}
+.ds-pills { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0 4px; }
+.ds-pill {
+  background: var(--nd-panel); border: 1px solid var(--nd-border);
+  color: var(--nd-muted); border-radius: 999px; padding: 8px 16px;
+  font: 600 0.8rem var(--nd-font-sans, Inter, system-ui, sans-serif);
+  cursor: pointer; transition: border-color 0.15s, color 0.15s;
+  text-decoration: none; display: inline-block;
+}
+.ds-pill:hover { border-color: var(--nd-lime); color: var(--nd-text); }
+.ds-pill.active { background: var(--nd-lime); border-color: var(--nd-lime); color: var(--nd-on-lime); }
+.ds-count { margin-left: auto; font: 500 0.85rem var(--nd-font-sans, Inter, system-ui, sans-serif); color: var(--nd-dim); }
+
+/* ---------- Table ---------- */
+.ds-table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid var(--nd-border); border-radius: 12px; background: var(--nd-panel); }
+.ds-table { width: 100%; min-width: 1080px; border-collapse: collapse; font-size: 0.9rem; }
+.ds-table thead th {
+  position: sticky; top: 0; z-index: 1;
+  background: var(--nd-panel-2); color: var(--nd-muted);
+  font: 600 0.68rem var(--nd-font-mono, "IBM Plex Mono", monospace);
+  letter-spacing: 0.08em; text-transform: uppercase;
+  text-align: left; padding: 12px 14px; white-space: nowrap;
+  border-bottom: 1px solid var(--nd-border-strong);
+  cursor: pointer; user-select: none;
+}
+.ds-table thead th.num { text-align: right; }
+.ds-table thead th:hover { color: var(--nd-text); }
+.ds-table thead th.sorted { color: var(--nd-lime); }
+.ds-table thead th .arr { color: var(--nd-lime); margin-left: 4px; }
+.ds-table thead th.no-sort { cursor: default; }
+.ds-table thead th.no-sort:hover { color: var(--nd-muted); }
+.ds-table tbody td {
+  padding: 11px 14px; border-bottom: 1px solid var(--nd-border);
+  color: var(--nd-text); font-variant-numeric: tabular-nums; white-space: nowrap;
+}
+.ds-table tbody td.num { text-align: right; }
+.ds-table tbody tr:last-child td { border-bottom: 0; }
+.ds-table tbody tr:hover { background: var(--nd-lime-faint); }
+.ds-table .sym { font-weight: 700; }
+.ds-table .sym a { color: var(--nd-text); text-decoration: none; }
+.ds-table .sym a:hover { color: var(--nd-lime); }
+.ds-table .cname { display: block; font-weight: 400; font-size: 0.75rem; color: var(--nd-dim); max-width: 220px; overflow: hidden; text-overflow: ellipsis; }
+.ds-table .up { color: var(--nd-up); font-weight: 600; }
+.ds-table .dn { color: var(--nd-down); font-weight: 600; }
+.ds-table .flat { color: var(--nd-flat); }
+.ds-table .unavail { color: var(--nd-dim); font-style: italic; font-size: 0.8rem; }
+.ds-empty { text-align: center; padding: 40px 20px !important; color: var(--nd-dim); }
+
+/* ---------- Pagination ---------- */
+.ds-below { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; margin: 14px 0 8px; }
+.ds-range { font: 500 0.85rem var(--nd-font-sans, Inter, system-ui, sans-serif); color: var(--nd-dim); }
+.ds-pager { display: flex; gap: 8px; align-items: center; }
+.ds-page-btn {
+  background: var(--nd-panel); border: 1px solid var(--nd-border);
+  color: var(--nd-text); border-radius: 8px; padding: 9px 18px;
+  font: 600 0.85rem var(--nd-font-sans, Inter, system-ui, sans-serif);
+  cursor: pointer; transition: border-color 0.15s;
+}
+.ds-page-btn:hover:not(:disabled) { border-color: var(--nd-lime); }
+.ds-page-btn:disabled { opacity: 0.4; cursor: default; }
+.ds-page-num { font: 600 0.85rem var(--nd-font-mono, "IBM Plex Mono", monospace); color: var(--nd-muted); }
+
+/* ---------- Notes ---------- */
+.ds-note {
+  margin: 26px 0 8px; padding: 16px 18px;
+  border: 1px solid var(--nd-border); border-radius: 10px;
+  background: var(--nd-panel); color: var(--nd-muted);
+  font-size: 0.85rem; line-height: 1.7;
+}
+.ds-note strong { color: var(--nd-text); }
+.ds-credit { font-size: 0.8rem; color: var(--nd-dim); margin: 1.25rem 0 0; }
+.ds-credit a { color: var(--nd-lime); }
+
+@media (max-width: 640px) {
+  .ds-count { margin-left: 0; width: 100%; }
+  .ds-search { max-width: none; }
+}
