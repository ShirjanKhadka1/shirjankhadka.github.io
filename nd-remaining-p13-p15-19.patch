+/* ---- Tabs ---- */
+.ipo-tabs{ display: flex; flex-wrap: wrap; gap: var(--nd-s2, 8px); margin: 0 0 var(--nd-s2, 8px); }
+.ipo-tab{
+  appearance: none; cursor: pointer; border: 1px solid var(--nd-border, #1E2430);
