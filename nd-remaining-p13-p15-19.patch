+/* ============================================================
+   nepse-ipo/ipo.css — IPO/FPO tracker (Concept 03 editorial)
+   Uses --nd-* tokens from nd-editorial-theme.css (dark-first,
+   light via [data-nd-ed="light"]). Tab pills, status badges,
+   dense sortable table, mobile horizontal scroll.
+   ============================================================ */
+
+.ipo-shell{ max-width: var(--nd-page-max, 1360px); margin: 0 auto; padding: 0 var(--nd-gutter, 24px) var(--nd-s16, 64px); }
+
+/* ---- Masthead ---- */
+.ipo-eyebrow{
+  font: 600 var(--nd-text-eyebrow, .6875rem) var(--nd-font-sans, system-ui);
+  letter-spacing: .22em; text-transform: uppercase; color: var(--nd-lime, #B8E62E);
+  margin: var(--nd-s8, 32px) 0 var(--nd-s3, 12px);
+}
+.ipo-title{
+  font-family: var(--nd-font-display, Georgia, serif); font-weight: 600;
+  font-size: var(--nd-text-h1, clamp(1.6rem, 1.65rem + .5vw, 1.85rem));
+  letter-spacing: -.015em; color: var(--nd-text, #fff); margin: 0 0 var(--nd-s3, 12px);
+}
+.ipo-lede{ max-width: 72ch; color: var(--nd-muted, #9AA3B2); font-size: var(--nd-text-body, .875rem); line-height: 1.7; margin: 0 0 var(--nd-s2, 8px); }
+.ipo-asof{ font-family: var(--nd-font-mono, monospace); font-size: var(--nd-text-meta, .6875rem); color: var(--nd-dim, #6B7280); margin: 0 0 var(--nd-s6, 24px); }
+
+/* ---- Open-now strip ---- */
+.ipo-open{ display: flex; flex-wrap: wrap; gap: var(--nd-s2, 8px); margin: 0 0 var(--nd-s6, 24px); }
+.ipo-open .open-chip{
+  display: inline-flex; align-items: center; gap: 8px;
+  background: var(--nd-lime-soft, rgba(184,230,46,.12)); border: 1px solid var(--nd-lime, #B8E62E);
+  border-radius: var(--nd-r-pill, 999px); padding: 8px 16px;
+  font-size: var(--nd-text-body-sm, .8125rem); font-weight: 600; color: var(--nd-text, #fff);
+  text-decoration: none;
+}
+.ipo-open .open-chip .dot{ width: 8px; height: 8px; border-radius: 50%; background: var(--nd-lime, #B8E62E); }
