+
+    // Signals
+    var sig = $('rgSignals');
+    if (sig) {
+      var d200 = r.sma200 ? ((r.close - r.sma200) / r.sma200 * 100) : null;
+      var d50 = r.sma50 ? ((r.close - r.sma50) / r.sma50 * 100) : null;
