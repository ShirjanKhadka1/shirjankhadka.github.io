+<script>
+(function(){
+"use strict";
+var BC = window.BrokerCommon;
+var state = { period: 'latest', brokers: {}, data: null, symbol: null, allSyms: [] };
+var $ = function(id){ return document.getElementById(id); };
+function bname(code){ return state.brokers[code] || ('Broker '+code); }
+
+function fillSymbols(){
+  var d = state.data, sel = $('symSel');
+  sel.innerHTML = '<option value="">Select stock…</option>';
+  state.allSyms = Object.keys(d.symbols||{}).sort();
+  state.allSyms.forEach(function(s){
+    var o = document.createElement('option'); o.value=s; o.textContent=s; sel.appendChild(o);
+  });
+  if(state.symbol && state.allSyms.indexOf(state.symbol)>=0) sel.value = state.symbol;
+}
+function pair6(v){
+  if(!Array.isArray(v)) return [0, v||0, 0, 0, 0, 0];
+  return [v[0]||0, v[1]||0, v[2]||0, v[3]||0, v[4]||0, v[5]||0];
+}
+function qv(v){ return Array.isArray(v) ? v : [0, v||0]; }
+function render(){
+  var d = state.data, sym = state.symbol;
+  if(!d || !sym) return;
+  var s = d.symbols[sym];
+  if(!s){ $('bkResult').innerHTML = '<div class="bk-empty">No trades for '+BC.esc(sym)+' in this period.</div>'; return; }
+  var net = {};
+  if(s.netflow && Object.keys(s.netflow).length){
+    Object.keys(s.netflow).forEach(function(c){ net[c] = pair6(s.netflow[c]); });
+  } else {
+    Object.keys(s.buyers||{}).forEach(function(c){ var v=qv(s.buyers[c]);
+      var e = net[c] = net[c] || [0,0,0,0,0,0]; e[2]+=v[0]; e[3]+=v[1]; e[0]+=v[0]; e[1]+=v[1]; });
+    Object.keys(s.sellers||{}).forEach(function(c){ var v=qv(s.sellers[c]);
+      var e = net[c] = net[c] || [0,0,0,0,0,0]; e[4]+=v[0]; e[5]+=v[1]; e[0]-=v[0]; e[1]-=v[1]; });
+  }
+  var rows = Object.keys(net).map(function(c){
+    return { code: c, name: bname(c), bq: net[c][2], bv: net[c][3], sq: net[c][4], sv: net[c][5],
+      nq: net[c][0], nv: net[c][1] };
+  });
+  var html = '<h2 style="font-family:var(--serif);font-size:1.2rem;margin:18px 0 4px">'+BC.esc(sym)+' — broker net positions</h2>'+
+    '<p class="bk-meta">'+BC.esc(BC.label(state.period,d))+' · '+rows.length+' brokers</p>'+
+    '<div class="bk-scroll"><table class="bk-table" id="bkTable"><thead><tr>'+
+    '<th data-sort="name">Broker</th><th data-sort="bv">Buy value</th><th data-sort="sv">Sell value</th>'+
+    '<th data-sort="nv">Net value</th><th data-sort="nq">Net qty</th><th data-sort="flow">Flow</th>'+
+    '</tr></thead><tbody id="bkBody"></tbody></table></div>';
+  $('bkResult').innerHTML = html;
+  function renderRows(rs){
+    $('bkBody').innerHTML = rs.map(function(r){
+      var tag = r.nv>0 ? '<span class="pos">accumulating</span>' : '<span class="neg">distributing</span>';
+      return '<tr><td><strong>'+BC.esc(r.name)+'</strong> <span style="color:var(--muted)">'+BC.esc(r.code)+'</span></td>'+
+        '<td>'+BC.fmtV(r.bv)+'</td><td>'+BC.fmtV(r.sv)+'</td>'+
+        '<td class="'+BC.cls(r.nv)+'">'+BC.fmtV(r.nv)+'</td>'+
+        '<td>'+BC.fmtN(r.nq,0)+'</td><td data-flow="'+(r.nv>0?'acc':'dist')+'">'+tag+'</td></tr>';
+    }).join('');
+  }
+  rows.forEach(function(r){ r.flow = r.nv>0 ? 1 : 0; });
+  renderRows(rows);
+  BC.makeSortable($('bkTable'), function(){ return rows; }, renderRows);
+}
+function load(){
+  $('bkResult').innerHTML = '<p class="bk-loading">Loading…</p>';
+  BC.loadPeriod(state.period).then(function(d){
+    state.data = d; fillSymbols(); render();
+    if(!state.symbol) $('bkResult').innerHTML = '<div class="bk-empty">Pick a stock above to see broker net positions.</div>';
+  }).catch(function(){
+    $('bkResult').innerHTML = '<div class="bk-empty">Data not available for this period yet.</div>';
+  });
+}
+$('symSel').addEventListener('change', function(){ state.symbol = this.value || null; render(); });
+$('symSearch').addEventListener('input', function(){
+  var q = this.value.trim().toUpperCase(), sel = $('symSel');
+  sel.innerHTML = '<option value="">Select stock…</option>';
+  state.allSyms.filter(function(s){return s.indexOf(q)>=0}).slice(0,100).forEach(function(s){
+    var o = document.createElement('option'); o.value=s; o.textContent=s; sel.appendChild(o);
+  });
+});
+$('bkPeriods').addEventListener('click', function(e){
+  var b = e.target.closest('button'); if(!b) return;
+  document.querySelectorAll('#bkPeriods button').forEach(function(x){x.classList.remove('active')});
+  b.classList.add('active'); state.period = b.dataset.p; load();
+});
+Promise.all([BC.loadMeta(), BC.loadBrokers()]).then(function(res){
+  state.brokers = res[1]; load();
+});
+})();
+</script>
+<script src="/js/nd-chrome.js?v=20261003a" defer></script>
+</body>
+</html>
