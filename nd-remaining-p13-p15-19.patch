diff --git a/css/nd-news.css b/css/nd-news.css
new file mode 100644
index 00000000..a16beaae
--- /dev/null
+++ b/css/nd-news.css
@@ -0,0 +1,199 @@
+/**
+ * css/nd-news.css — Market News page (Concept 03 editorial, P17).
+ * Magazine layout: featured lead + card grid, symbol monogram tiles
+ * (honest placeholders, never fake logos), category pills.
+ * Built on --nd-* theme tokens; light/dark both render correctly.
+ */
+
+.nn-wrap { max-width: var(--nd-page-max, 1360px); margin: 0 auto; padding: 0 var(--nd-gutter, 24px); }
+
+/* ---------- Masthead ---------- */
+.nn-masthead { margin: 8px 0 20px; }
+.nn-kicker {
+  font: 600 0.72rem var(--nd-font-mono, "IBM Plex Mono", monospace);
+  letter-spacing: 0.14em; text-transform: uppercase;
+  color: var(--nd-lime); margin: 0 0 8px;
+}
+.nn-masthead h1 {
+  font-family: var(--nd-font-display, "Spectral", Georgia, serif);
+  font-weight: 600; font-size: clamp(1.7rem, 4vw, 2.5rem);
+  letter-spacing: -0.015em; color: var(--nd-text); margin: 0;
+}
+.nn-lede { margin: 10px 0 0; max-width: 76ch; color: var(--nd-muted); line-height: 1.65; font-size: 0.95rem; }
+.nn-meta-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; align-items: center; }
+.nn-badge {
+  font: 600 0.7rem var(--nd-font-mono, "IBM Plex Mono", monospace);
+  letter-spacing: 0.06em; text-transform: uppercase;
+  padding: 6px 12px; border-radius: 6px;
+  border: 1px solid var(--nd-border); color: var(--nd-muted);
+  background: var(--nd-panel);
+}
+.nn-badge.lime { color: var(--nd-lime); border-color: var(--nd-lime); }
+.nn-badge .dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--nd-up); margin-right: 6px; }
+
+/* ---------- Tabs ---------- */
+.nn-tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--nd-border); margin: 4px 0 20px; }
+.nn-tab {
+  background: none; border: 0; border-bottom: 2px solid transparent;
+  color: var(--nd-muted); font: 600 0.9rem var(--nd-font-sans, Inter, sans-serif);
+  padding: 10px 16px; cursor: pointer; margin-bottom: -1px;
+}
+.nn-tab:hover { color: var(--nd-text); }
+.nn-tab[aria-selected="true"] { color: var(--nd-lime); border-bottom-color: var(--nd-lime); }
+
+/* ---------- Category pills ---------- */
+.nn-pills { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 16px; }
+.nn-pill {
+  background: var(--nd-panel); border: 1px solid var(--nd-border);
+  color: var(--nd-muted); border-radius: 999px; padding: 8px 16px;
+  font: 600 0.8rem var(--nd-font-sans, Inter, sans-serif);
+  cursor: pointer; transition: border-color 0.15s, color 0.15s;
+}
+.nn-pill:hover { border-color: var(--nd-lime); color: var(--nd-text); }
+.nn-pill[aria-selected="true"] { background: var(--nd-lime); border-color: var(--nd-lime); color: var(--nd-on-lime); }
+.nn-filter-row { display: flex; gap: 10px; align-items: center; margin-bottom: 6px; flex-wrap: wrap; }
+.nn-search {
+  flex: 1 1 220px; max-width: 340px;
+  background: var(--nd-panel); border: 1px solid var(--nd-border);
+  color: var(--nd-text); border-radius: 8px; padding: 10px 14px;
+  font: 500 0.9rem var(--nd-font-sans, Inter, sans-serif);
+}
+.nn-search::placeholder { color: var(--nd-dim); }
+.nn-search:focus { outline: none; border-color: var(--nd-lime); }
+.nn-count { font-size: 0.82rem; color: var(--nd-dim); white-space: nowrap; }
+.nn-updated { font-size: 0.78rem; color: var(--nd-dim); margin: 0 0 14px; }
+
+/* ---------- Featured lead ---------- */
+.nn-featured {
+  display: grid; grid-template-columns: 1fr; gap: 0;
+  background: var(--nd-panel); border: 1px solid var(--nd-border);
+  border-radius: var(--nd-r-card, 18px); overflow: hidden;
+  margin-bottom: 20px; text-decoration: none; color: inherit;
+}
+.nn-featured:hover { border-color: var(--nd-lime); }
+.nn-featured-art {
+  min-height: 180px; display: flex; align-items: center; justify-content: center;
+  background: linear-gradient(135deg, var(--nd-panel-2), var(--nd-inset));
+  border-bottom: 1px solid var(--nd-border); padding: 32px;
+}
+.nn-featured-art .nn-mono-lg {
+  width: 96px; height: 96px; border-radius: 22px;
+  display: flex; align-items: center; justify-content: center;
+  color: #fff; font: 800 1.6rem var(--nd-font-sans, Inter, sans-serif); letter-spacing: 0.04em;
+}
+.nn-featured-body { padding: 22px 24px; }
+.nn-cat {
+  font: 700 0.68rem var(--nd-font-mono, "IBM Plex Mono", monospace);
+  letter-spacing: 0.12em; text-transform: uppercase; margin: 0 0 8px;
+}
+.nn-cat.markets { color: var(--nd-lime); }
+.nn-cat.companies { color: var(--nd-info, #3080FF); }
+.nn-cat.economy { color: var(--nd-amber, #F5B301); }
+.nn-featured-body h2 {
+  font-family: var(--nd-font-display, "Spectral", Georgia, serif);
+  font-weight: 600; font-size: clamp(1.25rem, 2.6vw, 1.7rem);
+  line-height: 1.3; letter-spacing: -0.01em; color: var(--nd-text); margin: 0 0 10px;
+}
+.nn-featured:hover h2 { color: var(--nd-lime); }
+.nn-meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-size: 0.78rem; color: var(--nd-dim); }
+.nn-sym {
+  font: 700 0.75rem var(--nd-font-mono, "IBM Plex Mono", monospace);
+  color: var(--nd-lime); text-decoration: none; letter-spacing: 0.04em;
+}
+.nn-sym:hover { text-decoration: underline; }
+.nn-kind {
+  font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
+  padding: 3px 10px; border-radius: 999px; background: var(--nd-lime-faint, rgba(184,230,46,0.06));
+  color: var(--nd-lime); border: 1px solid var(--nd-lime);
+}
+.nn-kind.hot { background: var(--nd-lime); color: var(--nd-on-lime); border-color: var(--nd-lime); }
+
+/* ---------- Card grid ---------- */
+.nn-sec-h { font-family: var(--nd-font-display, "Spectral", serif); font-size: 1.15rem; font-weight: 600; color: var(--nd-text); margin: 26px 0 14px; }
+.nn-grid { display: grid; grid-template-columns: 1fr; gap: 14px; }
+@media (min-width: 720px) { .nn-grid { grid-template-columns: repeat(2, 1fr); } }
+@media (min-width: 1100px) { .nn-grid { grid-template-columns: repeat(3, 1fr); } }
+.nn-card {
+  background: var(--nd-panel); border: 1px solid var(--nd-border);
+  border-radius: var(--nd-r-card, 18px); padding: 18px;
+  display: flex; flex-direction: column; gap: 10px;
+  text-decoration: none; color: inherit;
+  transition: border-color 0.15s, transform 0.15s;
+}
+.nn-card:hover { border-color: var(--nd-lime); transform: translateY(-2px); }
+.nn-card-top { display: flex; align-items: center; gap: 12px; }
+.nn-mono {
+  flex: none; width: 44px; height: 44px; border-radius: 12px;
+  display: flex; align-items: center; justify-content: center;
+  color: #fff; font: 800 0.85rem var(--nd-font-sans, Inter, sans-serif); letter-spacing: 0.04em;
+}
+.nn-card h3 {
+  font-family: var(--nd-font-display, "Spectral", Georgia, serif);
+  font-weight: 600; font-size: 1.02rem; line-height: 1.4;
+  color: var(--nd-text); margin: 0;
+}
+.nn-card:hover h3 { color: var(--nd-lime); }
+.nn-card .nn-src { font-size: 0.72rem; color: var(--nd-dim); }
+.nn-card .nn-foot { margin-top: auto; padding-top: 4px; border-top: 1px solid var(--nd-border); display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-size: 0.76rem; color: var(--nd-dim); }
+
+/* ---------- Headline rows (editorial list) ---------- */
+.nn-rows { display: flex; flex-direction: column; }
+.nn-row {
+  display: grid; grid-template-columns: 64px 1fr; gap: 16px;
+  padding: 16px 4px; border-bottom: 1px solid var(--nd-border);
+  text-decoration: none; color: inherit; align-items: start;
+}
+.nn-row:last-child { border-bottom: 0; }
+.nn-row:hover .nn-row-title { color: var(--nd-lime); }
+.nn-row .nn-mono { width: 56px; height: 56px; border-radius: 14px; font-size: 0.95rem; }
+.nn-row-kicker { font: 700 0.66rem var(--nd-font-mono, "IBM Plex Mono", monospace); letter-spacing: 0.12em; text-transform: uppercase; color: var(--nd-dim); margin: 0 0 5px; }
+.nn-row-kicker .nn-cat { display: inline; }
+.nn-row-title {
+  font-family: var(--nd-font-display, "Spectral", Georgia, serif);
+  font-weight: 600; font-size: 1.08rem; line-height: 1.4; color: var(--nd-text); margin: 0 0 8px;
+  transition: color 0.15s;
+}
+
+/* ---------- Recency groups ---------- */
+.nn-group { margin-bottom: 8px; }
+.nn-group-head {
+  width: 100%; display: flex; align-items: center; gap: 10px;
+  padding: 14px 4px; background: none; border: 0; cursor: pointer;
+  font: 600 1rem var(--nd-font-display, "Spectral", serif); color: var(--nd-text); text-align: left;
+}
+.nn-group-head .chev { color: var(--nd-dim); transition: transform 0.2s; font-size: 0.8rem; }
+.nn-group.open .nn-group-head .chev { transform: rotate(180deg); }
+.nn-group-count {
+  margin-left: auto; font: 700 0.75rem var(--nd-font-mono, monospace);
+  color: var(--nd-dim); background: var(--nd-panel-2);
+  border-radius: 999px; padding: 2px 10px;
+}
+.nn-group-items { display: none; }
+.nn-group.open .nn-group-items { display: block; }
+
+/* ---------- Empty / states ---------- */
+.nn-empty {
+  padding: 40px 20px; text-align: center; color: var(--nd-dim); font-size: 0.92rem;
+  border: 1px dashed var(--nd-border-strong); border-radius: var(--nd-r-card, 18px);
+  background: var(--nd-panel);
+}
+
+/* ---------- Promises / FAQ ---------- */
+.nn-promise-grid { display: grid; grid-template-columns: 1fr; gap: 14px; margin-top: 44px; }
+@media (min-width: 720px) { .nn-promise-grid { grid-template-columns: repeat(3, 1fr); } }
+.nn-promise {
+  background: var(--nd-panel); border: 1px solid var(--nd-border);
+  border-radius: var(--nd-r-card, 18px); padding: 20px;
+}
+.nn-promise h3 { font-family: var(--nd-font-display, "Spectral", serif); font-size: 1.05rem; color: var(--nd-text); margin: 0 0 8px; }
+.nn-promise p { font-size: 0.85rem; color: var(--nd-muted); line-height: 1.6; margin: 0; }
+.nn-faq { margin-top: 36px; }
+.nn-faq h2 { font-family: var(--nd-font-display, "Spectral", serif); font-size: 1.25rem; color: var(--nd-text); margin: 0 0 12px; }
+.nn-faq details { border-top: 1px solid var(--nd-border); padding: 12px 0; }
+.nn-faq details:last-child { border-bottom: 1px solid var(--nd-border); }
+.nn-faq summary { cursor: pointer; font-weight: 600; font-size: 0.92rem; color: var(--nd-text); }
+.nn-faq details p { font-size: 0.87rem; color: var(--nd-muted); line-height: 1.65; margin: 8px 0 0; }
