+}
+.ipo-tab:hover{ border-color: var(--nd-border-strong, #2A3140); color: var(--nd-text, #fff); }
+.ipo-tab[aria-selected="true"]{ background: var(--nd-lime, #B8E62E); border-color: var(--nd-lime, #B8E62E); color: var(--nd-on-lime, #0A0C10); }
+.ipo-tab .cnt{ opacity: .65; font-weight: 500; }
+
+/* ---- Toolbar ---- */
+.ipo-toolbar{ display: flex; flex-wrap: wrap; gap: var(--nd-s3, 12px); align-items: center; justify-content: space-between; margin: var(--nd-s4, 16px) 0; }
+.ipo-count{ font-size: var(--nd-text-body-sm, .8125rem); color: var(--nd-dim, #6B7280); font-family: var(--nd-font-mono, monospace); }
