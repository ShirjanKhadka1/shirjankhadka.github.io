diff --git a/css/nd-daily.css b/css/nd-daily.css
index b03a3510..4fab576b 100644
--- a/css/nd-daily.css
+++ b/css/nd-daily.css
@@ -196,3 +196,34 @@
   .ds-ov-grid { grid-template-columns: 1fr; }
   .ds-ov-card .v { font-size: 1.2rem; }
 }
+
+/* ---------- Overview 2-column layout ---------- */
+.ds-ov-layout {
+  display: grid; grid-template-columns: 1fr 1fr;
+  gap: 18px; align-items: start;
+}
+.ds-ov-chart {
+  background: var(--nd-panel); border: 1px solid var(--nd-border);
+  border-radius: 12px; padding: 20px;
+}
+.ds-ov-chart-head {
+  display: flex; align-items: baseline; gap: 12px; margin-bottom: 12px;
+}
+.ds-ov-chart-title {
+  font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em;
+  background: #dc2626; color: #fff; padding: 4px 10px; border-radius: 4px;
+}
+.ds-ov-chart-val { font-size: 1.5rem; font-variant-numeric: tabular-nums; }
+.ds-ov-chart-val strong { font-weight: 700; color: var(--nd-text); }
+.ds-ov-chart-val .up { color: #4ade80; font-size: 1rem; }
+.ds-ov-chart-val .dn { color: #f87171; font-size: 1rem; }
+[data-theme="light"] .ds-ov-chart-val .up { color: #16a34a; }
+[data-theme="light"] .ds-ov-chart-val .dn { color: #dc2626; }
+#dsChartSvg { width: 100%; height: 220px; display: block; }
+.ds-ov-chart-note { font-size: 0.75rem; color: var(--nd-dim); margin-top: 8px; }
+.ds-ov-summary .ds-ov-grid { grid-template-columns: repeat(3, 1fr); }
+.ds-ov-summary .ds-ov-ranges { grid-template-columns: 1fr; }
+
+@media (max-width: 900px) {
+  .ds-ov-layout { grid-template-columns: 1fr; }
+}
