From 194a1fbbd40b1b1b0fd94368264eee1b67f65b54 Mon Sep 17 00:00:00 2001
From: Shirjan Khadka <shirjan.2.khadka@gmail.com>
Date: Sat, 3 Oct 2026 07:28:03 +0000
Subject: [PATCH 1/3] Design QA: fix header nav direction + footer placement
 collisions with legacy CSS

---
 css/nd-chrome.css | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/css/nd-chrome.css b/css/nd-chrome.css
index 92874cd6..8a34b1c7 100644
--- a/css/nd-chrome.css
+++ b/css/nd-chrome.css
@@ -68,7 +68,7 @@
 #nd-header .nd-results a .nm{ color: var(--nd-muted); font-size: 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
 #nd-header .nd-results a[aria-selected="true"], #nd-header .nd-results a:hover{ background: var(--nd-lime-faint); }
 /* Nav menus */
-#nd-header .nd-nav{ display: flex; align-items: center; gap: 2px; flex: none; }
+#nd-header .nd-nav{ display: flex; flex-direction: row; align-items: center; gap: 2px; flex: none; }
 #nd-header .nd-navitem{ position: relative; }
 #nd-header .nd-navbtn{
   display: flex; align-items: center; gap: 6px; height: 38px; padding: 0 8px;
@@ -181,6 +181,14 @@
 /* Adopted pages: the legacy sidebar is removed, so a shell left with a
    single content child collapses to one column instead of a 240px gap. */
 .nd-shell:not(:has(> aside)) { display: block; }
+/* Footer mounted INSIDE the legacy .d2-shell flex row: force it onto its own
+   full-width row below the content instead of squeezing beside it. */
+.d2-shell:has(> #nd-footer) { flex-wrap: wrap; }
+.d2-shell > #nd-footer { flex: 1 1 100%; min-width: 100%; }
+/* Footer as a direct body child after .d2-shell (short pages): sticky-footer
+   pattern so a 100vh shell doesn't strand the footer a viewport below. */
+body:has(> .d2-shell):has(> #nd-footer) { display: flex; flex-direction: column; min-height: 100vh; }
+body:has(> .d2-shell):has(> #nd-footer) > .d2-shell { flex: 1 0 auto; min-height: 0; }
 #nd-footer .nd-footwrap{ max-width: var(--nd-page-max); margin: 0 auto; padding: var(--nd-s12) var(--nd-gutter) var(--nd-s6); }
 #nd-footer .nd-footbrand{ display: flex; align-items: center; gap: var(--nd-s3); margin-bottom: var(--nd-s2); }
 #nd-footer .nd-footbrand svg{ width: 38px; height: 38px; border-radius: var(--nd-r-logo); }
-- 
2.43.0


