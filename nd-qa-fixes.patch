From 74f7ea7da421f5a4427559f173a2a42f4916d376 Mon Sep 17 00:00:00 2001
From: Shirjan Khadka <shirjan.2.khadka@gmail.com>
Date: Sat, 3 Oct 2026 07:33:19 +0000
Subject: [PATCH 3/3] Design QA: hide legacy floating theme toggle; sync
 sk-theme key

---
 css/nd-chrome.css | 4 ++++
 js/nd-chrome.js   | 1 +
 2 files changed, 5 insertions(+)

diff --git a/css/nd-chrome.css b/css/nd-chrome.css
index 399347c4..d94c8008 100644
--- a/css/nd-chrome.css
+++ b/css/nd-chrome.css
@@ -195,6 +195,10 @@ body:has(> .d2-shell):has(> #nd-footer) > .d2-shell { flex: 1 0 auto; min-height
 @media(min-width:1100px){
   body:has(> #nd-header){ padding-left: 0; }
 }
+/* Adopted pages: the header owns the theme switch — hide the legacy floating
+   .theme-toggle button injected by js/theme-toggle.js so it stops covering
+   content. The header toggle drives the same data-theme + storage keys. */
+body:has(> #nd-header) .theme-toggle.fixed{ display: none !important; }
 #nd-footer .nd-footwrap{ max-width: var(--nd-page-max); margin: 0 auto; padding: var(--nd-s12) var(--nd-gutter) var(--nd-s6); }
 #nd-footer .nd-footbrand{ display: flex; align-items: center; gap: var(--nd-s3); margin-bottom: var(--nd-s2); }
 #nd-footer .nd-footbrand svg{ width: 38px; height: 38px; border-radius: var(--nd-r-logo); }
diff --git a/js/nd-chrome.js b/js/nd-chrome.js
index fa2df290..fcb98687 100644
--- a/js/nd-chrome.js
+++ b/js/nd-chrome.js
@@ -133,6 +133,7 @@
     /* mirror legacy data-theme so existing chart observers keep working */
     root.setAttribute('data-theme', mode === 'light' ? 'light' : 'dark');
     store('nd-ed-theme', mode);
+    store('sk-theme', mode); /* keep the legacy pre-paint snippet in sync */
     var btn = $('#nd-themebtn');
     if (btn) {
       btn.setAttribute('aria-pressed', mode === 'light' ? 'true' : 'false');
-- 
