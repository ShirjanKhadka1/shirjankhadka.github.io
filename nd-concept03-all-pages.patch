diff --git a/css/nd-home.css b/css/nd-home.css
index f1c28a19..144715d0 100644
--- a/css/nd-home.css
+++ b/css/nd-home.css
@@ -75,3 +75,104 @@ body.d2 input:focus-visible {
   outline: none;
   box-shadow: var(--nd-focus-ring);
 }
+
+/* ============================================================
+   Concept 03 homepage rebuild — editorial sections
+   Index strip, Market Wrap feature, NEPSE index card, Newsroom.
+   Real data only — no mock figures.
+   ============================================================ */
+
+.nd-home{ max-width: var(--nd-page-max); margin: 0 auto; padding: 0 var(--nd-gutter); }
+
+/* ---------- Index strip ---------- */
+.nd-istrip{ position: relative; margin: var(--nd-s6) 0; }
+.nd-istrip-track{
+  display: flex; gap: var(--nd-s3); overflow-x: auto; padding: 4px 2px 12px;
+  scrollbar-width: none; -webkit-overflow-scrolling: touch;
+}
+.nd-istrip-track::-webkit-scrollbar{ display: none; }
+.nd-icard{
+  flex: 0 0 auto; min-width: 148px; padding: var(--nd-s4) var(--nd-s4);
+  background: var(--nd-panel); border: 1px solid var(--nd-border);
+  border-radius: var(--nd-r-md); text-decoration: none; color: var(--nd-text);
+  transition: border-color var(--nd-t-fast) var(--nd-ease), transform var(--nd-t-fast) var(--nd-ease);
+}
+.nd-icard:hover{ border-color: var(--nd-lime); transform: translateY(-2px); }
+.nd-icard .nm{ font: 500 0.75rem var(--nd-font-sans); color: var(--nd-muted); margin-bottom: 6px; white-space: nowrap; }
+.nd-icard .vl{ font: 600 1.25rem var(--nd-font-sans); font-variant-numeric: tabular-nums; }
+.nd-icard .ch{ font: 500 0.8125rem var(--nd-font-sans); margin-top: 4px; font-variant-numeric: tabular-nums; }
+.nd-icard .ch.up{ color: #4ade80; }
+.nd-icard .ch.dn{ color: #f87171; }
+.nd-istrip-nav{
+  position: absolute; top: 50%; transform: translateY(-50%);
+  width: 36px; height: 36px; border-radius: 50%;
+  background: var(--nd-panel); border: 1px solid var(--nd-border);
+  color: var(--nd-text); cursor: pointer; z-index: 2;
+  display: flex; align-items: center; justify-content: center;
+}
+.nd-istrip-nav.prev{ left: -12px; }
+.nd-istrip-nav.next{ right: -12px; }
+.nd-istrip-nav:hover{ border-color: var(--nd-lime); }
+
+/* ---------- Market Wrap + Index card ---------- */
+.nd-wrapgrid{
+  display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--nd-s8);
+  margin: var(--nd-s10) 0; align-items: start;
+}
+@media (max-width: 900px){ .nd-wrapgrid{ grid-template-columns: 1fr; } }
+.nd-badges{ display: flex; gap: var(--nd-s2); flex-wrap: wrap; margin-bottom: var(--nd-s4); }
+.nd-badge{
+  font: 600 0.6875rem var(--nd-font-mono); letter-spacing: 0.08em; text-transform: uppercase;
+  padding: 6px 12px; border-radius: 6px; border: 1px solid var(--nd-border);
+  color: var(--nd-muted); background: var(--nd-panel);
+}
+.nd-badge.lime{ color: var(--nd-lime); border-color: var(--nd-lime); }
+.nd-badge.amber{ color: #fbbf24; border-color: #fbbf24; }
+.nd-wraphead{
+  font-family: var(--nd-font-display); font-weight: 700;
+  font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.1; letter-spacing: -0.02em;
+  color: var(--nd-text); margin: 0 0 var(--nd-s5);
+}
+.nd-wraphead em{ font-style: italic; color: var(--nd-lime); }
+.nd-wrapbody{ font: 400 1.0625rem/1.7 var(--nd-font-sans); color: var(--nd-muted); margin: 0 0 var(--nd-s4); }
+.nd-wrapbody p{ margin: 0 0 var(--nd-s4); }
+.nd-wrapmeta{ font: 500 0.8125rem var(--nd-font-sans); color: var(--nd-dim); margin-bottom: var(--nd-s5); }
+.nd-wrapmeta strong{ color: var(--nd-text); }
+.nd-btn-lime{
+  display: inline-flex; align-items: center; gap: 8px;
+  background: var(--nd-lime); color: #0a0c10; font: 600 0.9375rem var(--nd-font-sans);
+  padding: 14px 24px; border-radius: 10px; text-decoration: none; border: 0; cursor: pointer;
+  transition: transform var(--nd-t-fast) var(--nd-ease), box-shadow var(--nd-t-fast) var(--nd-ease);
+}
+.nd-btn-lime:hover{ transform: translateY(-2px); box-shadow: 0 8px 24px rgba(184,230,46,.25); }
+
+/* NEPSE index card */
+.nd-ixcard{ background: var(--nd-panel); border: 1px solid var(--nd-border); border-radius: var(--nd-r-lg); padding: var(--nd-s6); }
+.nd-ixcard .lbl{ font: 600 0.75rem var(--nd-font-mono); letter-spacing: 0.1em; color: var(--nd-muted); display: flex; justify-content: space-between; align-items: center; }
+.nd-ixcard .big{ font: 700 2.5rem var(--nd-font-sans); font-variant-numeric: tabular-nums; color: var(--nd-text); margin: 8px 0 4px; }
+.nd-ixcard .chg{ font: 500 0.9375rem var(--nd-font-sans); margin-bottom: var(--nd-s4); }
+.nd-ixcard .chg.up{ color: #4ade80; }
+.nd-ixcard .chg.dn{ color: #f87171; }
+.nd-ixgrid{ display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--nd-s4); margin-bottom: var(--nd-s4); }
+.nd-ixgrid .cell .k{ font: 500 0.6875rem var(--nd-font-mono); letter-spacing: 0.06em; color: var(--nd-dim); margin-bottom: 4px; }
+.nd-ixgrid .cell .v{ font: 600 0.9375rem var(--nd-font-sans); color: var(--nd-text); font-variant-numeric: tabular-nums; }
+.nd-ixfoot{ border-top: 1px solid var(--nd-border); padding-top: var(--nd-s4); display: flex; gap: var(--nd-s4); align-items: flex-start; }
+.nd-ixfoot .note{ font: 400 0.8125rem/1.6 var(--nd-font-sans); color: var(--nd-dim); }
+
+/* ---------- Newsroom ---------- */
+.nd-newsroom{ margin: var(--nd-s12) 0; }
+.nd-newsroom-head{ display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--nd-s6); flex-wrap: wrap; gap: var(--nd-s3); }
+.nd-newsroom-head h2{ font-family: var(--nd-font-display); font-weight: 700; font-size: 1.75rem; color: var(--nd-text); margin: 0; }
+.nd-newsroom-head .sub{ font: 400 0.875rem var(--nd-font-sans); color: var(--nd-dim); }
+.nd-newsgrid{ display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--nd-s5); }
+@media (max-width: 900px){ .nd-newsgrid{ grid-template-columns: 1fr; } }
+.nd-newscard{ background: var(--nd-panel); border: 1px solid var(--nd-border); border-radius: var(--nd-r-lg); padding: var(--nd-s6); }
+.nd-newscard .cat{ display: flex; align-items: center; gap: 8px; font-family: var(--nd-font-display); font-weight: 600; font-size: 1.125rem; color: var(--nd-text); margin-bottom: var(--nd-s4); }
+.nd-newscard .cat .dot{ width: 10px; height: 10px; border-radius: 3px; background: var(--nd-lime); flex: none; }
+.nd-newsitem{ padding: var(--nd-s3) 0; border-bottom: 1px solid var(--nd-border); }
+.nd-newsitem:last-child{ border-bottom: 0; }
+.nd-newsitem a{ text-decoration: none; color: var(--nd-text); display: block; }
+.nd-newsitem a:hover .t{ color: var(--nd-lime); }
+.nd-newsitem .t{ font: 500 0.9375rem/1.5 var(--nd-font-sans); margin-bottom: 6px; transition: color var(--nd-t-fast); }
+.nd-newsitem .m{ font: 400 0.75rem var(--nd-font-mono); color: var(--nd-dim); display: flex; gap: 8px; align-items: center; }
+.nd-newsitem .m .tag{ color: var(--nd-lime); font-weight: 600; }
diff --git a/css/nd-screener.css b/css/nd-screener.css
new file mode 100644
index 00000000..6570f1ae
--- /dev/null
+++ b/css/nd-screener.css
@@ -0,0 +1,101 @@
+/* ============================================================
+   NEPSE Screener — Concept 03 editorial layout
+   sec-head, verdict card, pillrow filters, tbl-card.
+   Tokens from nd-editorial-theme.css (--nd-*).
+   ============================================================ */
+
+/* ---------- Section head (eyebrow + title + note) ---------- */
+.sc-sec-head {
+  display: flex; align-items: baseline; justify-content: space-between;
+  gap: 14px; margin: 34px 0 14px; flex-wrap: wrap;
+}
+.sc-sec-head:first-child { margin-top: 26px; }
+.sc-eyebrow {
+  font-size: 10px; font-weight: 600; letter-spacing: .22em;
+  text-transform: uppercase; color: var(--nd-lime); margin: 0 0 8px;
+}
+.sc-sec-head h2 {
+  font-family: var(--nd-font-display, "Spectral", Georgia, serif);
+  font-weight: 600; font-size: 24px; line-height: 1.2; margin: 0;
+  color: var(--nd-text);
+}
+.sc-sec-head .sc-note { font-size: 12px; color: var(--nd-dim); }
+
+/* ---------- Engine verdict card ---------- */
+.sc-verdict {
+  background: linear-gradient(135deg, rgba(184,230,46,.14), var(--nd-panel) 55%);
+  border: 1px solid rgba(184,230,46,.35);
+  border-radius: 16px; padding: 22px;
+  display: grid; grid-template-columns: auto 1fr auto;
+  gap: 18px; align-items: center; margin-top: 20px;
+}
+.sc-verdict .sc-score {
+  font-family: var(--nd-font-mono, "IBM Plex Mono", ui-monospace, monospace);
+  font-size: 42px; font-weight: 700; color: var(--nd-lime); line-height: 1;
+  font-variant-numeric: tabular-nums;
+}
+.sc-verdict h3 {
+  font-family: var(--nd-font-display, "Spectral", Georgia, serif);
+  font-size: 20px; font-weight: 600; margin: 0; color: var(--nd-text);
+}
+.sc-verdict p {
+  color: var(--nd-muted); margin: 6px 0 0; font-size: 13.5px; max-width: 62ch;
+  line-height: 1.6;
+}
+.sc-verdict .sc-vtag {
+  font-family: var(--nd-font-mono, "IBM Plex Mono", ui-monospace, monospace);
+  font-size: 11px; font-weight: 700; letter-spacing: .08em;
+  border: 1px solid var(--nd-lime); color: var(--nd-lime);
+  border-radius: 99px; padding: 7px 12px; white-space: nowrap;
+}
+@media (max-width: 1020px) { .sc-verdict { grid-template-columns: 1fr; } }
+
+/* ---------- Pill row filters ---------- */
+.sc-pillrow { display: flex; gap: 6px; flex-wrap: wrap; margin: 16px 0; }
+.sc-pillrow button {
+  background: var(--nd-panel); border: 1px solid var(--nd-border);
+  color: var(--nd-muted); font-size: 12.5px; font-weight: 600;
+  padding: 8px 14px; border-radius: 99px; cursor: pointer;
+  font-family: inherit; transition: background .15s, color .15s, border-color .15s;
+}
+.sc-pillrow button:hover { border-color: var(--nd-lime); color: var(--nd-text); }
+.sc-pillrow button.active {
+  background: var(--nd-lime); color: var(--nd-on-lime); border-color: var(--nd-lime);
+}
+
+/* ---------- Table card ---------- */
+.sc-tbl-card {
+  background: var(--nd-panel); border: 1px solid var(--nd-border);
+  border-radius: 14px; overflow: hidden;
+}
+.sc-tbl-card .sc-tc-head {
+  padding: 14px 18px 10px; display: flex;
+  justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap;
+}
+.sc-tbl-card .sc-tc-head h3 {
+  font-family: var(--nd-font-display, "Spectral", Georgia, serif);
+  font-size: 16px; font-weight: 600; margin: 0; color: var(--nd-text);
+}
+.sc-tbl-card .sc-tc-head span { font-size: 11px; color: var(--nd-dim); }
+.sc-tbl-scroll { overflow-x: auto; }
+.sc-tbl-card table { width: 100%; border-collapse: collapse; font-size: 13px; }
+.sc-tbl-card th {
+  font-size: 10.5px; text-transform: uppercase; letter-spacing: .07em;
+  color: var(--nd-dim); font-weight: 600; text-align: left;
+  padding: 8px 14px; border-top: 1px solid var(--nd-border);
+  border-bottom: 1px solid var(--nd-border);
+  background: var(--nd-panel-2); white-space: nowrap;
+}
+.sc-tbl-card td {
+  padding: 9px 14px; border-bottom: 1px solid var(--nd-border);
+  font-variant-numeric: tabular-nums; color: var(--nd-text);
+}
+.sc-tbl-card tr:last-child td { border-bottom: none; }
+.sc-tbl-card tbody tr { transition: background .12s; }
+.sc-tbl-card tbody tr:hover { background: rgba(184,230,46,.045); }
+.sc-tbl-card td.num, .sc-tbl-card th.num {
+  text-align: right; font-family: var(--nd-font-mono, "IBM Plex Mono", ui-monospace, monospace);
+}
+.sc-tbl-card td.sym { font-family: var(--nd-font-mono, "IBM Plex Mono", ui-monospace, monospace); font-weight: 600; }
+.sc-tbl-card th.sortable { cursor: pointer; user-select: none; }
+.sc-tbl-card th.sortable:hover { color: var(--nd-lime); }
diff --git a/js/nd-home.js b/js/nd-home.js
new file mode 100644
index 00000000..0c278ab3
--- /dev/null
+++ b/js/nd-home.js
@@ -0,0 +1,177 @@
+/**
+ * js/nd-home.js — Concept 03 editorial homepage sections.
+ * Renders index strip, market wrap, and newsroom from REAL data only.
+ * No mock figures. Every number comes from live.json or news.json.
+ */
+(function () {
+  'use strict';
+
+  var LIVE_URL = '/nepse-chart/data/live.json';
+  var NEWS_URL = '/nepse-chart/data/news.json';
+
+  function $(id) { return document.getElementById(id); }
+  function esc(s) {
+    return String(s == null ? '' : s).replace(/&/g, '&amp;')
+      .replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
+  }
+  function fmtNum(v, dp) {
+    if (v == null || !isFinite(Number(v))) return '—';
+    return Number(v).toLocaleString('en-US', {
+      minimumFractionDigits: dp == null ? 2 : dp,
+      maximumFractionDigits: dp == null ? 2 : dp
+    });
+  }
+  function fetchJSON(url) {
+    return fetch(url, { cache: 'no-store' }).then(function (r) {
+      if (!r.ok) throw new Error('HTTP ' + r.status);
+      return r.json();
+    });
+  }
+
+  /* ---------- Index strip ---------- */
+  function renderStrip(indices) {
+    var track = $('ndStripTrack');
+    if (!track || !indices || !indices.length) return;
+    // Order: NEPSE first, then sub-indices by absolute change
+    var sorted = indices.slice().sort(function (a, b) {
+      if (a.name === 'NEPSE') return -1;
+      if (b.name === 'NEPSE') return 1;
+      return Math.abs(b.percent_change || 0) - Math.abs(a.percent_change || 0);
+    });
+    track.innerHTML = sorted.map(function (ix) {
+      var chg = Number(ix.percent_change) || 0;
+      var cls = chg > 0 ? 'up' : chg < 0 ? 'dn' : '';
+      var arrow = chg > 0 ? '▲' : chg < 0 ? '▼' : '·';
+      var href = ix.name === 'NEPSE' ? '/nepse-chart/' : '/nepse-sectors/';
+      return '<a class="nd-icard" href="' + href + '">' +
+        '<div class="nm">' + esc(ix.name) + '</div>' +
+        '<div class="vl">' + fmtNum(ix.value) + '</div>' +
+        '<div class="ch ' + cls + '">' + arrow + ' ' + (chg > 0 ? '+' : '') + chg.toFixed(2) + '%</div>' +
+        '</a>';
+    }).join('');
+    var prev = $('ndStripPrev'), next = $('ndStripNext');
+    if (prev) prev.onclick = function () { track.scrollBy({ left: -320, behavior: 'smooth' }); };
+    if (next) next.onclick = function () { track.scrollBy({ left: 320, behavior: 'smooth' }); };
+  }
+
+  /* ---------- Market Wrap (generated from real session data) ---------- */
+  function renderWrap(live) {
+    var host = $('ndWrap');
+    if (!host || !live || !live.index) return;
+    var ix = live.index;
+    var chg = Number(ix.change) || 0;
+    var pct = Number(ix.percent_change) || 0;
+    var dir = chg > 0 ? 'higher' : chg < 0 ? 'lower' : 'flat';
+    var sessDate = '';
+    try {
+      var d = new Date((live.data_asof || live.asof));
+      sessDate = d.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Asia/Kathmandu' });
+    } catch (e) {}
+    // Leading/lagging sectors from indices
+    var sectors = (live.indices || []).filter(function (x) {
+      return x.name !== 'NEPSE' && x.name !== 'Sensitive' && x.name !== 'Float' && x.name !== 'Sensitive Float';
+    });
+    sectors.sort(function (a, b) { return (b.percent_change || 0) - (a.percent_change || 0); });
+    var leaders = sectors.slice(0, 2).map(function (x) { return x.name; }).join(' and ');
+    var laggards = sectors.slice(-2).map(function (x) { return x.name; }).join(' and ');
+
+    var headline = 'NEPSE closes ' + dir;
+    if (Math.abs(pct) >= 0.5) headline += ' sharply';
+    headline += ' at ' + fmtNum(ix.value);
+    if (leaders) headline += ' as ' + esc(leaders.toLowerCase()) + ' lead';
+
+    var body1 = 'The NEPSE index closed at ' + fmtNum(ix.value) + ' (' +
+      (chg > 0 ? '+' : '') + fmtNum(chg) + ' points, ' +
+      (pct > 0 ? '+' : '') + pct.toFixed(2) + '%). ';
+    if (leaders) {
+      body1 += chg >= 0
+        ? 'Strength came from ' + esc(leaders) + ' shares. '
+        : esc(leaders) + ' shares declined the least. ';
+    }
+    if (laggards && laggards !== leaders) body1 += 'Weakness was concentrated in ' + esc(laggards) + '. ';
+    body1 += 'Day range: ' + fmtNum(ix.low) + ' – ' + fmtNum(ix.high) + '.';
+
+    host.innerHTML =
+      '<div class="nd-badges">' +
+        '<span class="nd-badge lime">Market Wrap</span>' +
+        '<span class="nd-badge">' + esc(sessDate) + '</span>' +
+        '<span class="nd-badge amber">Closing figures · ' + esc(sessDate.toUpperCase()) + '</span>' +
+      '</div>' +
+      '<h2 class="nd-wraphead">' + esc(headline) + '</h2>' +
+      '<div class="nd-wrapbody"><p>' + body1 + '</p>' +
+      '<p>All figures below are the official session close. Quotes refresh during market hours; ' +
+      'outside hours the last close is shown.</p></div>' +
+      '<div class="nd-wrapmeta"><strong>Nepse Decode Desk</strong> · Data as of ' + esc(sessDate) + ' · Source: NEPSE</div>' +
+      '<a class="nd-btn-lime" href="/nepse-chart/">See today\'s market →</a>';
+  }
+
+  /* ---------- NEPSE index card ---------- */
+  function renderIndexCard(live) {
+    var host = $('ndIxCard');
+    if (!host || !live || !live.index) return;
+    var ix = live.index;
+    var chg = Number(ix.change) || 0;
+    var pct = Number(ix.percent_change) || 0;
+    var cls = chg > 0 ? 'up' : chg < 0 ? 'dn' : '';
+    var arrow = chg > 0 ? '▲' : chg < 0 ? '▼' : '·';
+    host.innerHTML =
+      '<div class="lbl"><span>NEPSE INDEX</span><span class="nd-badge amber">' + esc(live.market || '—') + '</span></div>' +
+      '<div class="big">' + fmtNum(ix.value) + '</div>' +
+      '<div class="chg ' + cls + '">' + arrow + ' ' + (chg > 0 ? '+' : '') + fmtNum(chg) +
+        ' (' + (pct > 0 ? '+' : '') + pct.toFixed(2) + '%) today</div>' +
+      '<div class="nd-ixgrid">' +
+        '<div class="cell"><div class="k">OPEN</div><div class="v">—</div></div>' +
+        '<div class="cell"><div class="k">HIGH</div><div class="v">' + fmtNum(ix.high) + '</div></div>' +
+        '<div class="cell"><div class="k">LOW</div><div class="v">' + fmtNum(ix.low) + '</div></div>' +
+        '<div class="cell"><div class="k">PREV CLOSE</div><div class="v">' + fmtNum(ix.previous_close) + '</div></div>' +
+      '</div>' +
+      '<div class="nd-ixfoot"><span class="nd-badge amber">Source: NEPSE</span>' +
+      '<span class="note">Figures are the official session close. Live quotes resume at the next market open.</span></div>';
+  }
+
+  /* ---------- Newsroom ---------- */
+  function renderNewsroom(items) {
+    var host = $('ndNewsGrid');
+    if (!host || !items || !items.length) return;
+    // Categorize: markets / companies / economy (simple keyword buckets)
+    var cats = { Markets: [], Companies: [], 'Economy & Policy': [] };
+    items.forEach(function (n) {
+      var t = ((n.title || '') + ' ' + (n.summary || '')).toLowerCase();
+      if (/nrb|sebon|policy|economy|remittance|ipo|government|budget/.test(t)) cats['Economy & Policy'].push(n);
+      else if (/hydropower|bank|insurance|finance|company|ltd|dividend|bonus/.test(t)) cats.Companies.push(n);
+      else cats.Markets.push(n);
+    });
+    host.innerHTML = Object.keys(cats).map(function (cat) {
+      var list = cats[cat].slice(0, 4);
+      if (!list.length) return '';
+      return '<div class="nd-newscard"><div class="cat"><span class="dot"></span>' + esc(cat) + '</div>' +
+        list.map(function (n) {
+          var href = n.url || n.link || '/nepse-news/';
+          var time = n.published || n.date || '';
+          var tag = (n.tags && n.tags[0]) || (n.symbol || '');
+          return '<div class="nd-newsitem"><a href="' + esc(href) + '">' +
+            '<div class="t">' + esc(n.title || 'Untitled') + '</div>' +
+            '<div class="m"><span>' + esc(time) + '</span>' +
+            (tag ? '<span class="tag">' + esc(String(tag).toUpperCase()) + '</span>' : '') +
+            '</div></a></div>';
+        }).join('') + '</div>';
+    }).join('');
+  }
+
+  /* ---------- Init ---------- */
+  function init() {
+    if (!$('ndStripTrack') && !$('ndWrap') && !$('ndNewsGrid')) return;
+    fetchJSON(LIVE_URL).then(function (live) {
+      renderStrip(live.indices);
+      renderWrap(live);
+      renderIndexCard(live);
+    }).catch(function () {});
+    fetchJSON(NEWS_URL).then(function (news) {
+      var items = Array.isArray(news) ? news : (news.items || news.news || []);
+      renderNewsroom(items);
+    }).catch(function () {});
+  }
+
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
+  else init();
+})();
diff --git a/js/nd-screener-verdict.js b/js/nd-screener-verdict.js
new file mode 100644
